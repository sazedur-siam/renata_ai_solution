# Copy to .env.local and fill in. Never commit real keys.

# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: defaults to gemini-flash-latest
GEMINI_MODEL=

# Optional: only set if you want to override the model's default temperature
GEMINI_TEMPERATURE=

# Optional locally (data/policy.md is used if present).
# Required on Vercel: paste the full contents of data/policy.md here.
POLICY_MD=
